@model IEnumerable<UserDto>
@{
    ViewData["Title"] = "Index";
}

<h1>All Users</h1>

<br />

<form>
    <div>
        <div class="row">
            <div class="col-6">
                <input placeholder="Search By Name" name="SearchInput" class="form-control" />
            </div>
            <div class="col-6">
                <input type="submit" class="btn btn-success" value="Search" />
            </div>
        </div>
    </div>
</form>


<br />
<br />

@if (Model.Count() > 0)
{
    <table class="table table-hover table-striped">
        <thead>
            <tr>
                <td>Id</td>
                <td>First Name</td>
                <td>Last Name</td>
                <td>Username</td>
                <td>Email</td>
                <td>Roles</td>
                <td>Details</td>
                <td>Update</td>
                <td>Delete</td>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>@item.UserName</td>
                    <td>@item.Email</td>
                    <td>
                        @if (item.Roles?.Count() <= 0)
                        {
                            <span>No Roles</span>
                        }
                        else
                        {
                            foreach (var Role in item.Roles)
                            {
                                <span>@Role</span>
                                <br />
                            }
                        }
                    </td>
                    <partial name="_ButtonPartialView" model="@item.Id" />
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="mt-4 alert alert-info">
        <h4>
            There Are No Any Users :(
        </h4>
    </div>
}



