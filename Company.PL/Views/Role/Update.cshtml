@model RoleDto 
@{
    ViewData["Title"] = "Update";
}

<h1>Update User</h1>

<br />
<br />

<form asp-controller="Role" asp-action="Update">
    <div asp-validation-summary="ModelOnly"></div>
    <partial name="PartialView/Create_Update_PartialView" />

    <div class="my-3">
        <input type="submit" value="Update" class="btn btn-success" />
        <a asp-controller="Role" asp-action="Index" class="btn btn-light">Back To List</a>
        <a asp-controller="Role" asp-action="AddOrRemoveUser" asp-route-RoleId="@Model.Id" class="btn btn-light">Add Or Remove User</a>
    </div>
</form>

@section Validation_Section {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}