@model IEnumerable<RoleDto>
@{
    ViewData["Title"] = "Index";
}

<h1>All Roles</h1>

<br />

<a asp-controller="Role" asp-action="Create" class="btn btn-primary">Create Role</a>

<br />
<br />




<form>
    <div>
        <div class="row">
            <div class="col-6">
                <input placeholder="Search By Name" name="SearchInput" class="form-control" />
            </div>
            <div class="col-6">
                <input type="submit" class="btn btn-success" value="Search" />
            </div>
        </div>
    </div>
</form>


<br />
<br />

@if (Model.Count() > 0)
{
    <table class="table table-hover table-striped">
        <thead>
            <tr>
                <td>Id</td>
                <td>Name</td>
                <td>Details</td>
                <td>Update</td>
                <td>Delete</td>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <partial name="_ButtonPartialView" model="@item.Id" />
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="mt-4 alert alert-info">
        <h4>
            There Are No Any Roles :(
        </h4>
    </div>
}



