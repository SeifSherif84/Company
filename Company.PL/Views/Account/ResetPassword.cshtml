@model ResetPasswordDto
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}


<div class="main-agileinfo">
	<div class="agileits-top">
		<div asp-validation-summary="All" class="my-2"></div>
		<form asp-action="ResetPassword">
			<div class="my-3">
				<input asp-for="NewPassword" class="form-control" placeholder="New Password" />
				<span asp-validation-for="NewPassword"></span>
			</div>
			<div class="my-3">
				<input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password" />
				<span asp-validation-for="ConfirmPassword"></span>
			</div>
			<input type="submit" value="Reset Password">
		</form>
	</div>
</div>

@section Registration_Validation_Section {
	<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
	<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
