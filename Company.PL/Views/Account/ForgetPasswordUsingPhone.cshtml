@model ForgetPasswordByPhoneDto
@{
	ViewData["Title"] = "Forget Password Using Phone";
	Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-agileinfo">
	<div class="agileits-top">
		<div asp-validation-summary="All" class="my-2"></div>
		<form asp-action="SendResetPasswordSmsUrl">
			<div class="my-3">
				<input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" />
				<span asp-validation-for="PhoneNumber"></span>
			</div>
			<input type="submit" value="Reset Password">
		</form>
	</div>
</div>

@section Registration_Validation_Section {
	<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
	<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
